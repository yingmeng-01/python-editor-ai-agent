# 依赖目录
frontend/node_modules/
backend/node_modules/

# 构建输出
frontend/dist/
backend/dist/

# 环境变量（包含 API 密钥）
.env
.env.local
.env.*.local

# 日志文件
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 编辑器配置
.idea/
.vscode/
*.swp
*.swo

# 操作系统文件
.DS_Store
Thumbs.db

# 临时文件
*.tmp
*.temp
.cache/

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
*.pyc

# jedi 缓存
.jedi/

# 测试覆盖率
coverage/
.nyc_output/

# 打包文件（如果使用 electron 等）
*.dmg
*.app
*.exe

# 备份文件
*.bak
*.backup

# 压缩文件（可选，如果你想单独上传视频）
# *.zip
# *.rar
# *.7z

# 演示视频（建议上传到视频平台，不要放 GitHub）
*.mp4
*.avi
*.mov
*.mkv

# deepseek 生成的临时文件
deepseek_*.jsx
deepseek_*.js